# Copy to .env.docker.local for a private local-only verification database.
SUPPORTPILOT_POSTGRES_DB=supportpilot_verification
SUPPORTPILOT_POSTGRES_USER=supportpilot
SUPPORTPILOT_POSTGRES_PASSWORD=choose-a-local-password
SUPPORTPILOT_POSTGRES_PORT=54329

# Place this URL in ignored .env.test.docker.local when running tests.
# DATABASE_URL=postgresql://supportpilot:choose-a-local-password@127.0.0.1:54329/supportpilot_verification
