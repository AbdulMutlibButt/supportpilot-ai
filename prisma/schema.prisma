generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  AGENT
  VIEWER
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
}

enum ConversationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum MessageAuthorType {
  CUSTOMER
  AGENT
  AI
}

enum EmbeddingStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum AIFeedbackValue {
  HELPFUL
  NOT_HELPFUL
}

enum Plan {
  FREE
  PRO
  BUSINESS
}

enum EmailType {
  INVITATION
  PASSWORD_RESET
  ASSIGNMENT
  HUMAN_ESCALATION
}

enum DeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

enum KnowledgeSourceType {
  PDF
  DOCX
  TXT
  ARTICLE
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

model User {
  id                  String              @id @default(cuid())
  email               String              @unique
  name                String
  passwordHash        String
  sessions            Session[]
  memberships         Membership[]
  invitationsSent     Invitation[]        @relation("Inviter")
  messages            Message[]
  assignments         Assignment[]        @relation("AssignedAgent")
  assignmentsMade     Assignment[]        @relation("AssignedBy")
  internalNotes       InternalNote[]
  activityEvents      ActivityEvent[]
  knowledgeDocuments  KnowledgeDocument[] @relation("KnowledgeCreator")
  knowledgeActivities DocumentActivity[]
  aiFeedback          AIFeedback[]
  passwordResets      PasswordResetToken[]
  emailMessages       DevelopmentEmail[] @relation("EmailRecipientUser")
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
}

model Workspace {
  id                   String                @id @default(cuid())
  name                 String
  slug                 String                @unique
  memberships          Membership[]
  invitations          Invitation[]
  customers            Customer[]
  conversations        Conversation[]
  tags                 Tag[]
  activityEvents       ActivityEvent[]
  knowledgeCollections KnowledgeCollection[]
  knowledgeDocuments   KnowledgeDocument[]
  processingJobs       ProcessingJob[]
  documentActivities   DocumentActivity[]
  chatbotConfig        ChatbotConfig?
  chatSessions         CustomerChatSession[]
  aiResponses          AIResponse[]
  aiUsage              AIUsageEvent[]
  plan                 Plan                  @default(FREE)
  subscriptionEvents   SubscriptionEvent[]
  developmentEmails    DevelopmentEmail[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
}

model SubscriptionEvent {
  id          String    @id @default(cuid())
  workspaceId String
  actorId     String?
  fromPlan    Plan
  toPlan      Plan
  description String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([workspaceId, createdAt(sort: Desc)])
}

model DevelopmentEmail {
  id              String         @id @default(cuid())
  workspaceId     String?
  recipientUserId String?
  toAddress       String
  subject         String
  previewBody     String
  actionUrl       String?
  type            EmailType
  status          DeliveryStatus @default(PENDING)
  attempts        Int            @default(0)
  failureReason   String?
  deliveredAt     DateTime?
  workspace       Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  recipientUser   User?          @relation("EmailRecipientUser", fields: [recipientUserId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([recipientUserId, createdAt(sort: Desc)])
  @@index([status, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model Customer {
  id            String         @id @default(cuid())
  workspaceId   String
  name          String
  email         String
  company       String?
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  messages      Message[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([workspaceId, email])
  @@index([workspaceId, name])
}

model Conversation {
  id              String               @id @default(cuid())
  workspaceId     String
  customerId      String
  subject         String
  status          ConversationStatus   @default(OPEN)
  priority        ConversationPriority @default(NORMAL)
  lastMessageAt   DateTime             @default(now())
  resolvedAt      DateTime?
  workspace       Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer        Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  messages        Message[]
  tags            ConversationTag[]
  assignment      Assignment?
  internalNotes   InternalNote[]
  activityEvents  ActivityEvent[]
  aiSuspended     Boolean              @default(false)
  humanTakeoverAt DateTime?
  chatSession     CustomerChatSession?
  aiResponses     AIResponse[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([workspaceId, status, lastMessageAt(sort: Desc)])
  @@index([workspaceId, priority])
  @@index([workspaceId, customerId])
}

model Message {
  id             String            @id @default(cuid())
  conversationId String
  authorType     MessageAuthorType
  body           String
  customerId     String?
  userId         String?
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  customer       Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  user           User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now())
  aiGenerated    Boolean           @default(false)
  aiResponse     AIResponse?

  @@index([conversationId, createdAt])
}

model Tag {
  id            String            @id @default(cuid())
  workspaceId   String
  name          String
  color         String            @default("#6558f5")
  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations ConversationTag[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model ConversationTag {
  conversationId String
  tagId          String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tag            Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@id([conversationId, tagId])
  @@index([tagId])
}

model Assignment {
  id             String       @id @default(cuid())
  conversationId String       @unique
  agentId        String
  assignedById   String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  agent          User         @relation("AssignedAgent", fields: [agentId], references: [id], onDelete: Cascade)
  assignedBy     User         @relation("AssignedBy", fields: [assignedById], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([agentId])
}

model InternalNote {
  id             String       @id @default(cuid())
  conversationId String
  authorId       String
  body           String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author         User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([conversationId, createdAt])
}

model ActivityEvent {
  id             String        @id @default(cuid())
  workspaceId    String
  conversationId String?
  actorId        String?
  type           String
  description    String
  metadata       Json?
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  actor          User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([conversationId, createdAt])
}

model Membership {
  id          String    @id @default(cuid())
  role        Role      @default(AGENT)
  userId      String
  workspaceId String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

model Invitation {
  id          String    @id @default(cuid())
  email       String
  role        Role      @default(AGENT)
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  workspaceId String
  invitedById String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy   User      @relation("Inviter", fields: [invitedById], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([workspaceId, email])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}

model KnowledgeCollection {
  id          String              @id @default(cuid())
  workspaceId String
  name        String
  description String?
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  documents   KnowledgeDocument[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId, createdAt])
}

model KnowledgeDocument {
  id               String               @id @default(cuid())
  workspaceId      String
  collectionId     String?
  creatorId        String
  title            String
  description      String?
  sourceType       KnowledgeSourceType
  originalFilename String?
  mimeType         String?
  fileSize         Int?
  storageKey       String?              @unique
  status           ProcessingStatus     @default(PENDING)
  failureReason    String?
  workspace        Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  collection       KnowledgeCollection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  creator          User                 @relation("KnowledgeCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  chunks           DocumentChunk[]
  jobs             ProcessingJob[]
  activities       DocumentActivity[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([workspaceId, status, updatedAt(sort: Desc)])
  @@index([workspaceId, collectionId])
  @@index([creatorId])
}

model DocumentChunk {
  id         String            @id @default(cuid())
  documentId String
  position   Int
  content    String
  pageNumber Int?
  section    String?
  metadata   Json?
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt  DateTime          @default(now())
  embedding  ChunkEmbedding?
  citations  AICitation[]

  @@unique([documentId, position])
  @@index([documentId, pageNumber])
}

model ProcessingJob {
  id            String            @id @default(cuid())
  workspaceId   String
  documentId    String
  status        ProcessingStatus  @default(PENDING)
  attempts      Int               @default(0)
  startedAt     DateTime?
  completedAt   DateTime?
  failureReason String?
  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  document      KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([workspaceId, status, createdAt])
  @@index([documentId, createdAt])
}

model DocumentActivity {
  id          String            @id @default(cuid())
  workspaceId String
  documentId  String
  actorId     String?
  type        String
  description String
  metadata    Json?
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  document    KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  actor       User?             @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([documentId, createdAt])
}

model ChunkEmbedding {
  id          String          @id @default(cuid())
  chunkId     String          @unique
  vector      Json?
  model       String
  dimensions  Int
  contentHash String
  status      EmbeddingStatus @default(PENDING)
  attempts    Int             @default(0)
  error       String?
  indexedAt   DateTime?
  chunk       DocumentChunk   @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([status, updatedAt])
  @@index([model, dimensions])
}

model ChatbotConfig {
  id             String                @id @default(cuid())
  workspaceId    String                @unique
  publicId       String                @unique @default(uuid())
  name           String                @default("Support assistant")
  welcomeMessage String                @default("Hi! How can we help?")
  color          String                @default("#6558f5")
  enabled        Boolean               @default(true)
  workspace      Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sessions       CustomerChatSession[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
}

model CustomerChatSession {
  id             String        @id @default(uuid())
  workspaceId    String
  chatbotId      String
  conversationId String        @unique
  tokenHash      String        @unique
  escalatedAt    DateTime?
  lastSeenAt     DateTime      @default(now())
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  chatbot        ChatbotConfig @relation(fields: [chatbotId], references: [id], onDelete: Cascade)
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())

  @@index([workspaceId, lastSeenAt])
  @@index([chatbotId, createdAt])
}

model AIResponse {
  id             String        @id @default(cuid())
  workspaceId    String
  conversationId String?
  messageId      String?       @unique
  questionHash   String
  answer         String
  refused        Boolean       @default(false)
  model          String
  latencyMs      Int?
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message        Message?      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  citations      AICitation[]
  feedback       AIFeedback[]
  createdAt      DateTime      @default(now())

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([conversationId, createdAt])
}

model AICitation {
  id         String        @id @default(cuid())
  responseId String
  chunkId    String
  rank       Int
  excerpt    String
  response   AIResponse    @relation(fields: [responseId], references: [id], onDelete: Cascade)
  chunk      DocumentChunk @relation(fields: [chunkId], references: [id], onDelete: Restrict)
  createdAt  DateTime      @default(now())

  @@unique([responseId, chunkId])
  @@index([chunkId])
}

model AIFeedback {
  id         String          @id @default(cuid())
  responseId String
  userId     String
  value      AIFeedbackValue
  response   AIResponse      @relation(fields: [responseId], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime        @default(now())

  @@unique([responseId, userId])
}

model AIUsageEvent {
  id          String    @id @default(cuid())
  workspaceId String
  kind        String
  units       Int       @default(1)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([workspaceId, createdAt])
}
